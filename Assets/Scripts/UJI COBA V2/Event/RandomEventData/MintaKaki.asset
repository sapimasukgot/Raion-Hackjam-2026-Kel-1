  m_Script: {fileID: 11500000, guid: d8df7a0fc2b126a408f49b6e14013322, type: 3}
  m_Name: MintaKaki
  m_EditorClassIdentifier: Assembly-CSharp::RandomEventSO
  eventTitle: Minta Kaki
  eventDescription: Bau anyir tercium tajam menembus ventilasi ruangan. Tetangga-tetangga
    tampaknya sedang mempersiapkan pesta besar di alun-alun desa. Seseorang mengetuk
    jendela dengan ritme yang lambat dan menyiksa. "Kami punya terlalu banyak makanan,"
    bisiknya dari balik kayu barikade. "Tapi kami butuh sebuah kaki agar dewa kami
    bisa berjalan. Berikan, dan kalian tidak akan kelaparan." Membayangkannya saja
    membuat isi perut bergejolak, tapi mereka benar-benar butuh makanan itu.
  eventIcon: {fileID: 0}
